<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FrameFit</AssemblyName>
    <RootNamespace>FrameFit.App</RootNamespace>
    <!--
      מטא-דאטה של מוצר וזכויות. הוא נכתב לתוך קובץ ההרצה ומופיע בלשונית "פרטים"
      של Windows, כך שהודעת הזכויות מלווה את התוצר שמופץ ולא רק את המאגר.
      הגרסה נשמרת זהה לזו של המתקין ב-installer/FrameFit.wxs.
    -->
    <Product>FrameFit</Product>
    <Company>Lev-Good</Company>
    <Copyright>Copyright (c) 2026 Lev-Good</Copyright>
    <Version>0.1.4</Version>
    <Description>התאמת אזור העבודה של Windows לשטח המסך שגלוי בפועל, כולל שוליים לא-סימטריים.</Description>
    <!-- השפה אינה במשאבים חיצוניים; המחרוזות מקודדות בממשק. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFit.Core\FrameFit.Core.csproj" />
    <ProjectReference Include="..\FrameFit.Platform.Windows\FrameFit.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
