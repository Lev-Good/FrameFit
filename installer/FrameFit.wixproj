<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    פרויקט הבנייה של המתקין. הוא נבנה בנפרד מהפתרון הראשי, כדי שדחיפת קוד רגילה
    לא תדרוש את כלי ה-WiX.

    WiX נבחר בגרסה 5 ולא 7: גרסה 7 דורשת הסכמה ל-Open Source Maintenance Fee,
    ואילו גרסה 5 פטורה מהיטל זה.

    הרישיון של WiX (בכל הגרסאות) הוא MS-RL — Microsoft Reciprocal License — ולא MIT.
    הוא רישיון הדדי החל על קוד המקור של WiX עצמו; הוא אינו מחייב לפתוח את המקור של
    המתקין שנבנה באמצעותו, אך הוא כן מחייב לשמר את הודעת הזכויות של WiX בהפצה.
    ראו THIRD-PARTY-NOTICES.md.
  -->
  <PropertyGroup>
    <OutputName>FrameFit-v0.1.4-x64</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!--
      ICE61 מושתק בגלל הסרת גרסה קודמת, ו-ICE91 מפני שהחבילה מיועדת
      למשתמש בודד (perUser) במפורש. שאר בדיקות ה-ICE רצות כרגיל.
    -->
    <SuppressIces>ICE61;ICE91</SuppressIces>
    <!-- נתיב מוחלט לתוצר ההרצה — מועבר לקובץ ההגדרה כמשתנה. -->
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\publish\single\</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
